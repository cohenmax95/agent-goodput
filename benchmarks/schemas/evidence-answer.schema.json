{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "conclusion",
    "evidence",
    "uncertainties"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "fact"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "fact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    }
  }
}

